#include <bits/stdc++.h>
using namespace std;

struct SNode { int data; SNode* next; };
struct DNode { int data; DNode* prev; DNode* next; };

SNode* shead = nullptr;
DNode* dhead = nullptr;

//Singly Linked List 
int countSS() {
    int c = 0;
    for (SNode* t = shead; t; t = t->next) c++;
    return c;
}

int findIndexSS(int val) {
    int i = 0;
    for (SNode* t = shead; t; t = t->next, i++)
        if (t->data == val) return i;
    return -1;
}

void insertingSS(int data, int index) {
    if (index < 0) { cout << "Invalid index\n"; return; }
    SNode* newNode = new SNode{data, nullptr};

    if (index == 0) {
        newNode->next = shead;
        shead = newNode;
        return;
    }
    SNode* temp = shead;
    for (int i = 0; i < index - 1 && temp; i++) temp = temp->next;

    if (!temp) { cout << "Invalid index\n"; delete newNode; return; }

    newNode->next = temp->next;
    temp->next = newNode;
}

void displaySS() {
    for (SNode* t = shead; t; t = t->next) cout << t->data << " -> ";
    cout << "NULL\n";
}

//Doubly Linked List
int countDLL() {
    int c = 0;
    for (DNode* t = dhead; t; t = t->next) c++;
    return c;
}

int findIndexDLL(int val) {
    int i = 0;
    for (DNode* t = dhead; t; t = t->next, i++)
        if (t->data == val) return i;
    return -1;
}

void insertingDLL(int data, int index) {
    if (index < 0) { cout << "Invalid index\n"; return; }
    DNode* newNode = new DNode{data, nullptr, nullptr};

    if (index == 0) {
        newNode->next = dhead;
        if (dhead) dhead->prev = newNode;
        dhead = newNode;
        return;
    }
    DNode* temp = dhead;
    for (int i = 0; i < index - 1 && temp; i++) temp = temp->next;

    if (!temp) { cout << "Invalid index\n"; delete newNode; return; }

    newNode->next = temp->next;
    newNode->prev = temp;
    if (temp->next) temp->next->prev = newNode;
    temp->next = newNode;
}

void displayForwardDLL() {
    cout << "NULL <-> ";
    for (DNode* t = dhead; t; t = t->next) cout << t->data << " <-> ";
    cout << "NULL\n";
}

void displayBackwardDLL() {
    if (!dhead) { cout << "List empty\n"; return; }
    DNode* t = dhead;
    while (t->next) t = t->next;
    cout << "NULL <-> ";
    for (; t; t = t->prev) cout << t->data << " <-> ";
    cout << "NULL\n";
}

